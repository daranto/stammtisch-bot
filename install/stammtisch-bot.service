[Unit]
Description=Stammtisch Telegram-Bot (Weboberfläche auf Port 8080)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=stammtisch
Group=stammtisch
WorkingDirectory=/opt/stammtisch-bot
Environment=LANG=C.UTF-8 PYTHONUNBUFFERED=1 STAMMTISCH_DATA=/var/lib/stammtisch-bot STAMMTISCH_PORT=8080
ExecStart=/opt/stammtisch-bot/venv/bin/python -m stammtisch_bot
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=stammtisch-bot
ReadWritePaths=/var/lib/stammtisch-bot

[Install]
WantedBy=multi-user.target
